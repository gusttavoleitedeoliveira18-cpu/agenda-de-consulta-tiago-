# =====================================================================
# Variáveis de ambiente — copie para .env.local (NUNCA versionar .env.local).
# Os valores reais são cadastrados no .env.local e no painel da Vercel.
# =====================================================================

# ---------- Supabase (Project Settings → API Keys) — obrigatório ----------
# Usadas SOMENTE no servidor (o navegador nunca acessa o banco).
SUPABASE_URL=
# Chave secreta ("sb_secret_..."). Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Compatibilidade: se o projeto só tiver a chave antiga, use SUPABASE_SERVICE_ROLE_KEY.

# ---------- Site e fuso ----------
# Opcional: URL pública do site (https://...). Reforça a verificação de origem do formulário.
PUBLIC_SITE_URL=
# Horário de Brasília.
PROFESSIONAL_TIME_ZONE=America/Sao_Paulo

# ---------- Proteção anti-robô (Cloudflare Turnstile) — opcional, recomendado ----------
# Sem as duas chaves, o formulário é protegido apenas por honeypot + limite de tentativas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Apenas fora da Vercel ----------
# Cabeçalho de IP confiável do seu proxy reverso (na Vercel é automático: x-real-ip).
# TRUSTED_IP_HEADER=
