# =====================================================================
# Variáveis de ambiente — copie para .env.local (NUNCA versionar .env.local).
# Os valores reais são cadastrados no .env.local e no painel da Vercel.
# Nunca use prefixo NEXT_PUBLIC_ em chaves secretas.
# =====================================================================

# ---------- Supabase (Project Settings → API Keys) ----------
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable, "sb_publishable_..."). Sujeita às políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (secret, "sb_secret_..."). SOMENTE servidor; ignora RLS.
SUPABASE_SECRET_KEY=
# Compatibilidade com o projeto anterior (use só se ainda não tiver as chaves novas):
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------- Site e fuso ----------
# URL pública (https em produção), usada nos links dos e-mails. Ex.: https://seudominio.com.br
PUBLIC_SITE_URL=
# Fuso do profissional (IANA). Valor inicial sugerido, aguardando confirmação do proprietário.
PROFESSIONAL_TIME_ZONE=America/Bahia

# ---------- E-mail (Resend) ----------
RESEND_API_KEY=
# Remetente em domínio VERIFICADO no Resend. Ex.: Tiago Lima <agenda@seudominio.com.br>
EMAIL_FROM=
# Caixa que recebe os avisos internos (nova solicitação, resposta a proposta).
ADMIN_NOTIFICATION_EMAIL=
# Opcional: segredo de assinatura do webhook (Resend → Webhooks), formato whsec_...
RESEND_WEBHOOK_SECRET=

# ---------- Proteção antispam (Cloudflare Turnstile) — obrigatório em produção ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Rotinas automáticas ----------
# Segredo enviado pela Vercel Cron em "Authorization: Bearer ...". Gere com: openssl rand -hex 32
CRON_SECRET=

# ---------- Criptografia (obrigatório) ----------
# 32 bytes em base64. Cifra o link de proposta na fila de e-mails e pseudonimiza o rate limit.
# Gere com: openssl rand -base64 32   (trocar a chave invalida links de proposta ainda não enviados)
TOKEN_ENCRYPTION_KEY=

# ---------- Apenas fora da Vercel ----------
# Cabeçalho de IP confiável do seu proxy reverso (na Vercel é automático: x-real-ip).
# TRUSTED_IP_HEADER=

# ---------- Somente testes locais (ignorado na Vercel) ----------
# APP_TEST_MODE=1
# TEST_SERVICE_DURATIONS={"consultoria_online":60}
# TEST_RESEND_API_URL=http://127.0.0.1:4010
# TEST_TURNSTILE_VERIFY_URL=http://127.0.0.1:4010/siteverify
# TEST_DISABLE_RATE_LIMIT=1
